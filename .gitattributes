* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.svg text eol=lf whitespace=-blank-at-eol
*.csv -text whitespace=cr-at-eol
*.pdf binary
*.png binary
# Keep frozen artifacts byte-identical across Git checkouts and operating systems.
results/** -text whitespace=cr-at-eol
results/**/*.svg -text whitespace=-blank-at-eol,cr-at-eol
report/report.md -text whitespace=cr-at-eol
